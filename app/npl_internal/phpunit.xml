<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
         | The Go host bakes bootstrap/cache/{config,routes-v7,events}.php
         | for the running desk, with THAT machine's absolute paths and env.
         | A test run must never read them: a cached route table 404s every
         | route added since the last boot, and a cached config overrides
         | the in-memory database above with the desk's real SQLite file.
         | Pointing the cache paths at files that never exist keeps tests on
         | the live config/ and routes/ sources whatever the host last baked.
        -->
        <env name="APP_CONFIG_CACHE" value="storage/framework/testing/never-cached-config.php"/>
        <env name="APP_ROUTES_CACHE" value="storage/framework/testing/never-cached-routes.php"/>
        <env name="APP_EVENTS_CACHE" value="storage/framework/testing/never-cached-events.php"/>
    </php>
</phpunit>
