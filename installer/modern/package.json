{
  "name": "nplpoker-os-modern-installer",
  "version": "1.4.0",
  "private": true,
  "description": "Modern Electron installer shell for NPL Poker OS",
  "main": "electron/main.js",
  "author": "NPL Poker",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nplpoker.os.installer",
    "productName": "NPL Poker OS Installer",
    "asar": true,
    "compression": "store",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload/NPLPokerOS-Engine.exe",
        "to": "payload/NPLPokerOS-Engine.exe"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "NPLPokerOS-InstallOrUpdate-${version}-Modern.exe"
    },
    "portable": {
      "unicode": true,
      "requestExecutionLevel": "user",
      "splashImage": "build/splash.bmp"
    },
    "publish": null
  }
}
