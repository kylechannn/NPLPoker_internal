.tools/
dist/
logs/
ui/node_modules/
*.log
*.tmp

# Receipts printed through a print-to-file queue (no POS printer on the
# machine) land here as PDFs — runtime output, never part of the repo.
receipts/

# Claude Code session worktrees — never part of the product.
.claude/

# Bundled Laravel backend: vendor is restored by scripts/setup.ps1 (composer
# install) rather than committed, and runtime state never belongs in git.
app/npl_internal/vendor/
app/npl_internal/node_modules/
app/npl_internal/.env
app/npl_internal/storage/framework/cache/data/*
app/npl_internal/storage/framework/sessions/*
app/npl_internal/storage/framework/views/*
app/npl_internal/storage/logs/*
app/npl_internal/storage/app/media/
app/npl_internal/database/*.sqlite
app/npl_internal/database/*.sqlite-journal
app/npl_internal/.phpunit.result.cache


# Built desktop binaries — the exe is produced by a build, never committed.
NPLPokerOS.exe
nplpoker-internal.exe
NPLPokerOS.exe~

# Installer build artifacts — assembled by installer/build-installer.ps1.
installer/payload/
installer/output/
installer/app.ico
nplpoker-internal
