{
	auto_https off
	admin off
}

http://{$NPL_INTERNAL_LISTEN:127.0.0.1:8787} {
	bind {$NPL_INTERNAL_BIND:127.0.0.1}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# connect-src additionally allows the NPL cloud realtime link: the
		# backend-link WebSocket dials Reverb (ws-*.laravel.cloud) directly,
		# and a future custom realtime domain stays covered. Everything else
		# still rides the local proxy under 'self'.
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss://*.laravel.cloud https://*.laravel.cloud wss://*.nplpokerclub.com.au https://*.nplpokerclub.com.au; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	reverse_proxy {$NPL_INTERNAL_UPSTREAM:127.0.0.1:8788} {
		header_up X-NPL-Gateway "desktop"
	}
}

# A separate, route-limited LAN ingress for staff phone pairing. The desktop
# SPA and all operational APIs remain unreachable from this listener.
http://:{$NPL_STAFF_PORT:8790} {
	bind {$NPL_STAFF_BIND:0.0.0.0}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
		Cache-Control "no-store, max-age=0"
	}

	@staff_access path /staff-login /staff-login/* /api/staff-login/session
	handle @staff_access {
		reverse_proxy {$NPL_INTERNAL_UPSTREAM:127.0.0.1:8788} {
			header_up X-NPL-Gateway "staff"
		}
	}

	handle {
		respond 404
	}
}
